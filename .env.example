# ─── NASA Open APIs ────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — read by api/nasa.ts and the local Vite dev middleware.
# Get a free key at: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# ─── Supabase ──────────────────────────────────────────────────────────────────
# VITE_ prefix IS intentional. The anon key is designed to be browser-safe.
# Security is enforced via Row Level Security (RLS), not by hiding the key.
# See: https://supabase.com/docs/guides/api/api-keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── AI Farm Advisor ───────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — read by api/advisor.ts and the local Vite dev middleware.
# Set ONE in Vercel → Settings → Environment Variables → Secret:
OPENAI_API_KEY=            # sk-...         Standard OpenAI key
# GEMINI_API_KEY=          # AIza...        Google Gemini alternative
# OPENROUTER_API_KEY=      # sk-or-...      OpenRouter multi-model alternative
